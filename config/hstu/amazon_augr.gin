# HSTU config for Amazon dataset
# Hierarchical Sequential Transduction Unit
# Run: python genrec/trainers/augr_trainer.py config/hstu/amazon.gin

import genrec.data.amazon_hstu
import genrec.models.hstu_augr

# =============================================================================
# Training Settings
# =============================================================================
train.epochs = 300
train.batch_size = 128
train.learning_rate = 1e-3
train.weight_decay = 0.0

# =============================================================================
# Model Settings
# =============================================================================
train.max_seq_len = 50
train.embed_dim = 64
train.num_heads = 2
train.num_blocks = 2
train.dropout = 0.5

# =============================================================================
# AuGR
# =============================================================================
train.num_position_buckets = 32
train.num_time_buckets = 64
train.use_temporal_bias = True  # Set False to disable temporal bias (like SASRec)
train.ctr_mode="listnet"
train.listnet_scale = 20
train.lambda_ctr = 0.7
train.lambda_gen = 0.3
train.gen_loss_decay = False
train.model_name = "base-listnet-ctr-{split}-no-gen-decay"

# =============================================================================
# Dataset Settings
# =============================================================================
train.dataset_folder = "/home/work/chatbot-llms-3/bin.fu/genrec/genrec/data/dataset/amazon"
train.split = "{split}"  # beauty, sports, toys, clothing

# =============================================================================
# Evaluation Settings
# =============================================================================
train.do_eval = True
train.eval_every_epoch = 1
train.eval_batch_size = 256
train.patience = 50

# =============================================================================
# Checkpoint Settings
# =============================================================================
train.save_dir_root = "out/augr/amazon/{split}"
train.save_every_epoch = 50

# =============================================================================
# Logging Settings
# =============================================================================
train.wandb_logging = True
train.wandb_project = "augr_{split}_training"
train.wandb_log_interval = 100

# =============================================================================
# Accelerator Settings
# =============================================================================
train.amp = True
train.mixed_precision_type = "bf16"
